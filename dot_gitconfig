[user]
	name = Angsuman Ray
	email = angsuman@mikelegal.com

[init]
	defaultBranch = ultimate

[pull]
	rebase = true

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    features = catppuccin-macchiato

[delta "catppuccin-macchiato"]
    blame-palette = "#24273a #1e2030 #181926 #c6a0f6 #8aadf4"
    commit-decoration-style = "box ul"
    dark = true
    file-style = "#cad3f5"
    file-decoration-style = "#cad3f5"
    hunk-header-decoration-style = "box ul"
    hunk-header-file-style = "bold"
    hunk-header-line-number-style = "bold #a5adcb"
    hunk-header-style = "file line-number syntax"
    line-numbers = true
    line-numbers-left-style = "#6e738d"
    line-numbers-minus-style = "bold #ed8796"
    line-numbers-plus-style = "bold #a6da95"
    line-numbers-right-style = "#6e738d"
    line-numbers-zero-style = "#a5adcb"
    minus-emph-style = "bold syntax #53394c"
    minus-style = "syntax #3a273a"
    plus-emph-style = "bold syntax #3f5347"
    plus-style = "syntax #2b3a32"
    map-styles = bold purple => syntax #c6a0f6, bold blue => syntax #8aadf4, bold cyan => syntax #8bd5ca, bold yellow => syntax #eed49f
    syntax-theme = Catppuccin Macchiato

[merge]
    conflictstyle = diff3