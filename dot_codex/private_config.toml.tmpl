personality = "pragmatic"
[mcp_servers.sequentialthinking]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-sequential-thinking"]
enabled_tools = ["sequentialthinking"]

[mcp_servers.tavily]
command = "npx"
args = ["-y", "tavily-mcp@0.2.3"]

[mcp_servers.tavily.env]
TAVILY_API_KEY = "{{ (keepassxc "tavily-api-key").Password }}"

[mcp_servers."mcp-obsidian"]
command = "uvx"
args = ["mcp-obsidian"]
enabled = false

[mcp_servers."mcp-obsidian".env]
OBSIDIAN_API_KEY = "{{ (keepassxc "obsidian-api-key").Password }}"

[mcp_servers.filesystem]
command = "npx"
args = [
  "-y",
  "@modelcontextprotocol/server-filesystem",
  "/home/inthevortex/Code",
  "/home/inthevortex/Downloads",
  "/home/inthevortex/Documents"
]

[mcp_servers.Ref]
command = "npx"
args = ["ref-tools-mcp@latest"]

[mcp_servers.Ref.env]
REF_API_KEY = "{{ (keepassxc "ref-api-key").Password }}"

[mcp_servers."package-registry"]
command = "npx"
args = ["-y", "package-registry-mcp"]

[mcp_servers.deepwiki]
url = "https://mcp.deepwiki.com/mcp"

[mcp_servers.github]
command = "docker"
args = [
  "run",
  "-i",
  "--rm",
  "-e",
  "GITHUB_PERSONAL_ACCESS_TOKEN",
  "-e",
  "GITHUB_TOOLSETS",
  "-e",
  "GITHUB_READ_ONLY",
  "ghcr.io/github/github-mcp-server"
]

[mcp_servers.github.env]
GITHUB_PERSONAL_ACCESS_TOKEN = "{{ (keepassxc "gh_cr_pat").Password }}"
GITHUB_TOOLSETS = ""
GITHUB_READ_ONLY = ""

[mcp_servers.sentry]
command = "uvx"
args = ["mcp-server-sentry", "--auth-token", "{{ (keepassxc "sentry-token").Password }}"]

[mcp_servers.playwright]
command = "npx"
args = ["-y", "@playwright/mcp@0.0.38"]
enabled = false

[projects."/home/inthevortex/Code/Personal/game-launcher"]
trust_level = "trusted"

[projects."/home/inthevortex"]
trust_level = "trusted"
