# Starship Configuration (Chezmoi Template)
"$schema" = "https://starship.rs/config-schema.json"

# Sets user-defined palette
palette = "catppuccin_macchiato"

# Inserts a blank line between shell prompts
add_newline = false
command_timeout = 10000

# Clean, simplified format using $all
format = """
$os\
$shlvl\
$username\
$hostname\
$directory\
$git_branch\
$git_commit\
$git_state\
$git_status\
$all\
$sudo\
$cmd_duration\
$line_break\
$jobs\
$battery\
$time\
$status\
$character"""

[os]
disabled = false
format = "[$symbol]($style)"
style = "bold blue"

{{- if .isLaptop }}
[battery]
format = "on [$symbol$percentage]($style) "
full_symbol = "🔋 "
charging_symbol = "⚡️ "
discharging_symbol = "💀 "

[[battery.display]]
threshold = 10
style = "bold red"

[[battery.display]]
threshold = 30
style = "bold yellow"
discharging_symbol = "💦"
{{- else }}
[battery]
disabled = true
{{- end }}

[cmd_duration]
min_time = 1000
format = '\[[⏱ $duration]($style)\] '

[character]
success_symbol = "[[♥](green) ❯](maroon) "
error_symbol = "[✖](bold red) "
vimcmd_symbol = "[❮](green) "

[directory]
truncation_length = 3
truncate_to_repo = true
style = "bold lavender"
format = "[$path]($style)[$lock_symbol]($lock_style) "

[git_branch]
format = " [$symbol$branch]($style) "
symbol = "🌱 "
style = "bold yellow"

[git_commit]
commit_hash_length = 8
style = "bold white"
disabled = false

[git_state]
merge = "\uf419 "
cherry_pick = "🍒 PICKING"
revert = "⏪"
rebase = "🔀"
format = '\[[\($state( $progress_current of $progress_total)\)]($style)\]'

[git_status]
conflicted = "⚔️ "
ahead = "🏎️ 💨 ×${count}"
behind = "🐢 ×${count}"
diverged = "🔱 🏎️ 💨 ×${ahead_count} 🐢 ×${behind_count}"
untracked = "🛤️  ×${count}"
stashed = "📦 "
modified = "📝 ×${count}"
staged = "🗃️  ×${count}"
renamed = "📛 ×${count}"
deleted = "🗑️  ×${count}"
style = "bright-white"
format = '\[ $all_status$ahead_behind\]'

[hostname]
ssh_only = false
format = "<[$hostname]($style)>"
trim_at = "-"
style = "bold dimmed white"
disabled = true

[memory_usage]
format = '\[$symbol[${ram}( | ${swap})]($style)\]'
threshold = 70
style = "bold dimmed white"
disabled = false

[package]
disabled = true

[python]
format = '\[[${symbol}${pyenv_prefix}(${version})]($style)\]'
style = "bold green"

[time]
time_format = "%T"
format = "🕙 $time($style) "
style = "bright-white"
disabled = false

[username]
style_user = "bold dimmed blue"
show_always = false

[nodejs]
format = "via [🤖 $version](bold green) "
detect_files = ["package.json", ".node-version", ".nvmrc"]
detect_folders = ["node_modules"]

[golang]
format = "via [🐹 $version](bold cyan) "

[sudo]
format = '\[[as $symbol]\]'

[docker_context]
format = '\[[$symbol$context]($style)\]'

[dotnet]
format = '\[[$symbol($version)(🎯 $tfm)]($style)\]'

[aws]
format = '\[[$symbol($profile)(\($region\))(\[$duration\])]($style)\]'
symbol = '󰅟 '
style = "yellow"

[azure]
format = '\[[$symbol($subscription)]($style)\] '
symbol = '󰠅 '
style = "bold blue"
disabled = false

[gcloud]
format = '\[[$symbol$account(@$domain)(\($region\))]($style)\] '
symbol = '󱇶 '
style = "bold blue"
disabled = false

[rust]
format = "via [🦀 $version]($style) "
style = "bold peach"

[kubernetes]
format = 'via [$symbol$context( \($namespace\))]($style) '
symbol = '󱃾 '
style = "bold teal"
disabled = false

[terraform]
format = 'via [$symbol$version]($style) '
symbol = '󱁢 '
style = "bold mauve"
detect_extensions = ["tf", "tfplan", "tfstate", "tofu"]

[shlvl]
disabled = false
symbol = "↕️  "
format = "[$symbol$shlvl]($style) "

[palettes.catppuccin_macchiato]
rosewater = "#f4dbd6"
flamingo = "#f0c6c6"
pink = "#f5bde6"
mauve = "#c6a0f6"
red = "#ed8796"
maroon = "#ee99a0"
peach = "#f5a97f"
yellow = "#eed49f"
green = "#a6da95"
teal = "#8bd5ca"
sky = "#91d7e3"
sapphire = "#7dc4e4"
blue = "#8aadf4"
lavender = "#b7bdf8"
text = "#cad3f5"
subtext1 = "#b8c0e0"
subtext0 = "#a5adcb"
overlay2 = "#939ab7"
overlay1 = "#8087a2"
overlay0 = "#6e738d"
surface2 = "#5b6078"
surface1 = "#494d64"
surface0 = "#363a4f"
base = "#24273a"
mantle = "#1e2030"
crust = "#181926"