{
  "theme": "Catppuccin Macchiato",
  "icon_theme": "Catppuccin Macchiato",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  {{- if eq .chezmoi.os "darwin" }}
  "ui_font_size": 16,
  "buffer_font_size": 15,
  {{- else }}
  "ui_font_size": 15,
  "buffer_font_size": 14,
  {{- end }}
  "edit_predictions": {
    "provider": "copilot"
  },
  "git_panel": {
    "tree_view": true
  },
  "agent_servers": {
    "kilo": { "type": "registry" },
    "junie": { "type": "registry" },
    "github-copilot-cli": { "type": "registry" },
    "gemini": { "type": "registry" },
    "codex-acp": { "type": "registry" },
    "claude-acp": { "type": "registry" },
    "stakpak": { "type": "registry" },
    "github-copilot": { "type": "registry" },
    "opencode": { "type": "registry" }
  },
  "context_servers": {
    "obsidian": {
      "enabled": false,
      "command": "uvx",
      "args": ["mcp-obsidian"],
      "env": {
        "OBSIDIAN_API_KEY": "{{ (keepassxc "obsidian-api-key").Password }}"
      }
    },
    "deepwiki": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "mcp-deepwiki@latest"],
      "env": {}
    },
    "ref": {
      "enabled": true,
      "command": "npx",
      "args": ["ref-tools-mcp@latest"],
      "env": {
        "REF_API_KEY": "{{ (keepassxc "ref-api-key").Password }}"
      }
    },
    "mcp-server-sequential-thinking": {
      "enabled": true,
      "settings": {}
    },
    "playwright": {
      "env": {},
      "enabled": false,
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "package-registry": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "package-registry-mcp"],
      "env": {}
    },
    "filesystem": {
      "env": {},
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/inthevortex/Code",
        "/home/inthevortex/Downloads",
        "/home/inthevortex/Documents"
      ]
    },
    "mcp-server-tavily": {
      "enabled": true,
      "settings": {
        "tavily_api_key": "{{ (keepassxc "tavily-api-key").Password }}"
      }
    },
    "mcp-server-github": {
      "enabled": true,
      "settings": {
        "github_personal_access_token": "{{ (keepassxc "gh_cr_pat").Password }}"
      }
    }
  },
  "agent": {
    "default_profile": "write",
    "profiles": {
      "ask": {
        "name": "Ask",
        "tools": {
          "contents": true,
          "diagnostics": true,
          "fetch": true,
          "list_directory": true,
          "project_notifications": false,
          "now": true,
          "find_path": true,
          "read_file": true,
          "open": true,
          "grep": true,
          "thinking": true,
          "web_search": true
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "mcp-server-github": {
            "tools": {
              "list_repository_security_advisories": true,
              "list_secret_scanning_alerts": true,
              "list_releases": true,
              "list_org_repository_security_advisories": true,
              "list_pull_requests": true,
              "list_notifications": true,
              "list_issues": true,
              "list_issue_types": true,
              "list_gists": true,
              "list_global_security_advisories": true,
              "list_discussions": true,
              "list_discussion_categories": true,
              "list_dependabot_alerts": true,
              "list_commits": true,
              "list_code_scanning_alerts": true,
              "list_branches": true,
              "get_workflow_run_usage": true,
              "get_workflow_run_logs": false,
              "get_teams": true,
              "get_workflow_run": true,
              "get_team_members": true,
              "get_secret_scanning_alert": true,
              "get_tag": true,
              "get_release_by_tag": true,
              "get_pull_request_status": true,
              "get_pull_request_reviews": true,
              "get_pull_request_files": true,
              "get_pull_request_review_comments": true,
              "get_pull_request_diff": true,
              "get_pull_request": true,
              "get_notification_details": true,
              "get_me": true,
              "get_latest_release": true,
              "get_job_logs": true,
              "get_issue_comments": true,
              "get_issue": true,
              "get_global_security_advisory": true,
              "get_file_contents": true,
              "get_discussion_comments": true,
              "get_discussion": true,
              "get_dependabot_alert": true,
              "get_commit": true,
              "get_code_scanning_alert": true,
              "fork_repository": true,
              "download_workflow_run_artifact": true,
              "delete_workflow_run_logs": false,
              "delete_pending_pull_request_review": false,
              "delete_file": false,
              "create_repository": true,
              "create_pull_request": true,
              "create_pending_pull_request_review": true,
              "create_or_update_file": true,
              "create_gist": true,
              "create_issue": true,
              "create_branch": true,
              "create_and_submit_pull_request_review": true,
              "cancel_workflow_run": true,
              "assign_copilot_to_issue": true,
              "add_sub_issue": true,
              "add_issue_comment": true,
              "add_comment_to_pending_review": true
            }
          },
          "mcp-obsidian": {
            "tools": {
              "obsidian_simple_search": true,
              "obsidian_patch_content": true,
              "obsidian_list_files_in_vault": true,
              "obsidian_list_files_in_dir": true,
              "obsidian_get_recent_periodic_notes": true,
              "obsidian_get_recent_changes": true,
              "obsidian_get_periodic_note": true,
              "obsidian_get_file_contents": true,
              "obsidian_delete_file": true,
              "obsidian_complex_search": true,
              "obsidian_batch_get_file_contents": true,
              "obsidian_append_content": true
            }
          },
          "fetch": {
            "tools": {
              "fetch": true
            }
          },
          "Ref": {
            "tools": {
              "ref_search_documentation": true,
              "ref_read_url": true
            }
          }
        }
      }
    },
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "grok-code-fast-1"
    }
  },
  "show_edit_predictions": false,
  "base_keymap": "VSCode",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "autosave": "on_focus_change",
  "current_line_highlight": "gutter",
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true,
    "agent_review": true,
    "code_actions": true
  },
  "minimap": {
    "show": "auto",
    "thumb": "always",
    "thumb_border": "left_open",
    "current_line_highlight": "line"
  },
  "format_on_save": "on",
  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    },
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    }
  },
  "lsp": {
    "eslint": {
      "settings": {
        "codeActionOnSave": {
          "rules": ["import/order"]
        }
      }
    }
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true
    }
  },
  "preview_tabs": {
    "enabled": false,
    "enable_preview_from_file_finder": false,
    "enable_keep_preview_on_code_navigation": false
  },
  "terminal": {
    "alternate_scroll": "off",
    "blinking": "terminal_controlled",
    "copy_on_select": false,
    "dock": "bottom",
    {{- if eq .chezmoi.os "darwin" }}
    "option_as_meta": true,
    {{- else }}
    "option_as_meta": false,
    {{- end }}
    "button": true,
    "toolbar": {
      "breadcrumbs": true
    },
    "working_directory": "current_project_directory"
  },
  "project_panel": {
    "button": true,
    "default_width": 240,
    "dock": "left",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "scrollbar": {
      "show": "always"
    }
  },
  "unnecessary_code_fade": 0.5,
  "use_smartcase_search": true
}